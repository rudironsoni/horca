{
  "productionPrefixes": [
    "src/",
    "config/",
    "scripts/",
    "native/",
    "resources/",
    "mobile/",
    "overlay/"
  ],
  "productionFiles": [
    "package.json",
    "pnpm-workspace.yaml"
  ],
  "independentFiles": [
    "upstream.lock.json",
    "overlay/manifest.json",
    "pnpm-lock.yaml",
    "product.json"
  ],
  "nonProductionPrefixes": [
    "migration/",
    "docs/",
    "tests/",
