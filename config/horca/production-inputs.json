  ],
  "nonProductionFiles": [
    "LICENSE",
    ".gitignore"
  ],
  "nonProductionSuffixes": [
    ".test.ts",
    ".test.tsx",
    ".test.mjs",
    ".test.js"
  ],
  "nonProductionPathParts": [
    "/test-support/"
  ]
}
