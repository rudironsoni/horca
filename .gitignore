# Horca repository ignores.
# Upstream Orca's own .gitignore travels with the materialized worktree; this
# file only covers artifacts produced inside the Horca repository itself.

# Downstream orchestration cache
.cache/

# Dependencies and build output
node_modules/
out/
dist/

# TypeScript incremental build info
*.tsbuildinfo

# Logs
*.log

# Native build artifacts (sources live in native/*/src)
native/*/build/
native/*/node_modules/
native/**/build/
native/**/*.node
native/horca-ghostty/vendor/

# Xcode/SwiftPM scratch build dirs
native/*/.build/

# D2 Ghostty native build products (sources stay tracked)
native/**/build/
native/**/*.node
